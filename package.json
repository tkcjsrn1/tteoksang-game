{
  "name": "tteoksang-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "친구와 함께하는 가상 주식 멀티플레이 게임",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/src/index.ts",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "test:pg": "node --import tsx --test tests/postgres.integration.ts",
    "load": "tsx scripts/load-test.ts",
    "balance": "tsx scripts/balance.ts",
    "cap:sync": "vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "embedded-postgres": "17.2.0-beta.15",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
